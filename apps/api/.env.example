# Copy this file to .env (never commit .env).

# Neon (Option 2): pooled connection string, host contains "-pooler". Used by the API at runtime.
# Postgres on the VPS (Option 1): the same URL for both variables.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# Direct (unpooled) connection string, host WITHOUT "-pooler". Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# Copy this file to .env (never commit .env).

# Neon (Option 2): pooled connection string, host contains "-pooler". Used by the API at runtime.
# Postgres on the VPS (Option 1): the same URL for both variables.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# Direct (unpooled) connection string, host WITHOUT "-pooler". Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# ---- API server ----
PORT=3000
# Dev-only login via the x-dev-user-id header (until Better Auth in step 3a). Never true in production.
DEV_AUTH=true
# Required in production; optional in development. Secret: 32+ random characters.
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="https://api.example.com"
# Without these, emails (including codes) print to the API console. Required in production.
# RESEND_API_KEY=""
# MAIL_FROM="Chill Hub <no-reply@example.com>"
# Browser origins allowed to call the API (Expo web dev servers).
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# ---- Tests (npm run api:test) ----
# A separate Neon branch called "test". The tests WIPE this database on every run.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"
TEST_DIRECT_URL="postgresql://USER:PASSWORD@ep-yyyy.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

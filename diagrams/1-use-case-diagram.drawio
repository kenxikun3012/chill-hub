y="300" width="40" height="80" as="geometry"/></mxCell><mxCell id="c7" value="Tournament Organizer&lt;br&gt;(esports club moderator)" style="shape=umlActor;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;labelPosition=right;align=left;verticalLabelPosition=middle;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="300" width="40" height="80" as="geometry"/></mxCell><mxCell id="c8" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="610" y="560" width="40" height="80" as="geometry"/></mxCell><mxCell id="c9" value="Scheduler&lt;br&gt;(system timer)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="90" width="40" height="80" as="geometry"/></mxCell><mxCell id="e10" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="c6" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="c7" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="becomes (after admin approval)" style="endArrow=open;dashed=1;html=1;endSize=10;fontSize=11;fontColor=#555555;labelBackgroundColor=#FCFCFC;endArrow=open;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Arrows with a hollow triangle mean &lt;i&gt;is a kind of&lt;/i&gt;: the child actor can do everything the parent can.&lt;br&gt;• Lobby Host and Team Captain are temporary roles: any Player becomes a Host by creating a lobby, or a Captain by creating a team.&lt;br&gt;• Moderator, Tournament Organizer and Admin are roles assigned by an Admin.&lt;br&gt;• Scheduler represents timed system jobs (lobby expiry, reminders, ID photo deletion)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1010" y="330" width="330" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="1. Accounts &amp; Profiles"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c18" value="1. Accounts &amp; Profiles" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c19" value="Chill Hub: Accounts &amp; Profiles" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCFCFC;verticalAlign=top;fontStyle=1;fontSize=15;strokeColor=#666666;spacingTop=8;" vertex="1" paren
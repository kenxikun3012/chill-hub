ative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e62" value="«include»" style="endArrow=open;dashed=1;html=1;endSize=10;fontSize=11;fontColor=#555555;labelBackgroundColor=#FCFCFC;" edge="1" parent="1" source="c34" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e63" value="«include»" style="endArrow=open;dashed=1;html=1;endSize=10;fontSize=11;fontColor=#555555;labelBackgroundColor=#FCFCFC;" edge="1" parent="1" source="c35" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Yellow = MVP &amp;nbsp; Purple = Phase 2 &amp;nbsp; Dashed grey = Later&lt;br&gt;«include» = always performed as part of the base use case&lt;br&gt;«extend» = optional behaviour added to the base use case" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="260" y="898" width="430" height="74" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Lobby Recruitment &amp; Reputation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c65" value="2. Lobby Recruitment &amp; Reputation" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="c66" value="Chill Hub: Lobby Recruitment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCFCFC;verticalAlign=top;fontStyle=1;fontSize=15;strokeColor=#666666;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="750" height="972" as="geometry"/></mxCell><mxCell id="c67" value="Browse &amp; filter lobbies" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6
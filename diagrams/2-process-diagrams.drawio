eometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e91" value="No: stays Open for others" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="c67" target="c57"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2710.0" y="438"/><mxPoint x="1300.0" y="438"/></Array></mxGeometry></mxCell><mxCell id="e92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c68" target="c69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c93" value="&lt;b&gt;Spec rules:&lt;/b&gt; LOB-01 to LOB-08, LOB-13. A lobby cannot be published without its in-game code. Private lobby codes are only sent to accepted members (NFR-06)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="560" height="64" as="geometry"/></mxCell><mxCell id="c94" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;● Start &amp;nbsp;&amp;nbsp; ◉ End &amp;nbsp;&amp;nbsp; ◇ Decision &amp;nbsp;&amp;nbsp; ▭ Step (blue = user, green = system, orange = admin)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="670" y="630" width="520" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Process 2b: Play, close lobby &amp; rate teammates"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="